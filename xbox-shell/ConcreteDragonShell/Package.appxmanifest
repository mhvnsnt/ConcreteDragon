<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher MUST match the certificate used to sign the sideload package.
       With a VS-generated test certificate, set its subject here (default
       template value is the placeholder below). -->
  <Identity
    Name="ConcreteDragonShell"
    Publisher="CN=ConcreteDragonDev"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="b7e3d1a2-4c5f-4a1b-9c2d-3e4f5a6b7c8d" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Concrete Dragon</DisplayName>
    <PublisherDisplayName>Orion Enterprises LLC</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.15063.0" MaxVersionTested="10.0.17763.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="ConcreteDragonShell.App">
      <uap:VisualElements
        DisplayName="Concrete Dragon"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Concrete Dragon — live web build, hosted for Xbox Dev Mode"
        BackgroundColor="#0B0B10">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0B10" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The shell's one job is fetching the game over the network. -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
